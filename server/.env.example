# Database Configuration (Local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=desana_coffee
DB_USER=postgres
DB_PASSWORD=your_local_db_password

# Database Configuration (Supabase)
# Uncomment the line below and fill in your password to use Supabase PostgreSQL
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.yourproject.supabase.co:5432/postgres

# Supabase Project Credentials (Storage)
# Required if STORAGE_PROVIDER is set to 'supabase'
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key

# Backend config
# Set to 'local' to upload images to the local /uploads folder
# Set to 'supabase' to upload images to the Supabase Storage Bucket
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=supabase

# JWT Secret for authenticating owner login
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=3001

# Frontend URL for CORS
CORS_ORIGIN=http://localhost:5173
